INGESTION_FOLDERS_LOCAL_PATHS=include/data/
WEAVIATE_CONN_ID=weaviate_default
WEAVIATE_CLASS_NAME=MYDATA
WEAVIATE_VECTORIZER=text2vec-openai
WEAVIATE_SCHEMA_PATH=include/schema.json

OPENAI_API_KEY=<YOUR-OPENAI-API-KEY>

# The Weaviate provider connects over HTTP and gRPC, so the connection needs a plain
# host/port pair (not a URL) plus the gRPC host/port in the connection extras.
AIRFLOW_CONN_WEAVIATE_DEFAULT={"conn_type":"weaviate","host":"weaviate","port":8081,"extra":{"token":"adminkey","grpc_host":"weaviate","grpc_port":50051,"additional_headers":{"X-Openai-Api-Key":"<YOUR-OPENAI-API-KEY>"}}}

# Expose the Airflow configuration in the UI (Admin > Config). Off by default in Airflow 3;
# safe to enable for local development only.
AIRFLOW__API__EXPOSE_CONFIG=True
